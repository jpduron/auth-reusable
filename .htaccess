# =========================================
# CONFIGURACIÓN DE SEGURIDAD Y RUTAS (RAÍZ)
# =========================================

# 1. Proteger el listado de directorios
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /proyecto/

    # 2. Si es la raíz exacta, redirigir al login del frontend
    RewriteRule ^$ frontend/pages/login.html [R=301,L]

    # 3. Si alguien escribe /backend, redirigirlo a /backend/public/
    RewriteRule ^backend$ backend/public/ [R=301,L]

    # 4. Cualquier cosa que empiece con backend/ va a backend/public/
    # (Ej: /backend/login -> /backend/public/login)
    RewriteRule ^backend/(.*)$ backend/public/$1 [L]
</IfModule>